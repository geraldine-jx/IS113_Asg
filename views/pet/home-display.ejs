<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Home</title>
  <style>
    .heart{
    font-size: 22px;
    padding: 5px;
}
    .heart:hover{
    background-color: lightgray;
    }
</style>
</head>

<body>
    <h1>Get your Best Buddy Now!</h1>
    <p>
        <!-- Lead to give up page -->
       <a href="/give-up-dog">
            <button>Rehome</button>
        </a>

        <!-- Lead to profile page -->
        <a href="/profile">
            <button>User Profile</button>
        </a>
    </p>
    <p>Total pets: <%= pets.length %></p>
    <table border ="1"> 
        <% pets.forEach(pet => { %>
        <tr>
            <td>
                <!-- Display image -->
                <img src="<%= pet.image %>" alt="<%= pet.name %>" width="100">
            </td>
            <td>
                <!-- Display information -->
                Name: <%= pet.name %> <br>
                Breed: <%= pet.breed %> <br>
                Age: <%= pet.age %> <br>
                Status: <%= pet.status %><br>
                <br>

                <!-- Buttons -->
                <!-- Lead to adoption page -->
                <a href="/adopt-dog">
                    <button>Adopt</button>
                </a>
                
                <button type="details">More Info</button>
                <form action="/home-display/pets/<%= pet._id %>/toggleFavourite" method="POST" style="display:inline;">
                    <button type="submit" class="heart">
                    <%= favourites.includes(pet._id.toString()) ? "❤️" : "🤍" %>
                </button>
</form>
            </td>
        </tr>
        <% }) %>
    </table>
</body>

<script>
async function toggleHeart(element, petId) {

    const isCurrentlyFav = element.innerHTML.trim() === "❤️";

    try {
        const res = await fetch(`/home-display/pets/${petId}/toggleFavourite`, {
            method: "POST"
        });

        const data = await res.json();

        // update UI AFTER backend confirms
        element.innerHTML = data.favourited ? "❤️" : "🤍";

    } catch (err) {
        console.error("Error:", err);
    }
}
</script>

</html>
