<!DOCTYPE html>
<html>
<head>
  <title>Admin View Users</title>
</head>
<body>
  <h1>View Users</h1>

  <% if (error) { %>
    <p><%= error %></p>
  <% } %>

  <% if (message) { %>
    <p><%= message %></p>
  <% } %>

  <form action="/auth/admin/users" method="get">
    Search by username or display name:<br>
    <input type="text" name="search" value="<%= search %>">
    <button type="submit">Search</button>
  </form>

  <br>

  <% if (users.length === 0) { %>
    <p>No users found.</p>
  <% } else { %>
    <table border="1" cellpadding="8">
      <tr>
        <th>Username</th>
        <th>Display Name</th>
        <th>Email</th>
        <th>Contact</th>
        <th>Date Joined</th>
        <th>Action</th>
      </tr>
      <% users.forEach((user) => { %>
        <tr>
          <td><%= user.username %></td>
          <td><%= user.displayName %></td>
          <td><%= user.email %></td>
          <td><%= user.contact %></td>
          <td><%= user.formattedDateJoined %></td>
          <td>
            <form action="/auth/admin/users/delete" method="post" onsubmit="return confirm('Delete this user?');">
              <input type="hidden" name="userId" value="<%= user._id %>">
              <input type="hidden" name="search" value="<%= search %>">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  <% } %>

  <br>

  <a href="/auth/admin/dashboard">
    <button type="button">Back to Dashboard</button>
  </a>
</body>
</html>
