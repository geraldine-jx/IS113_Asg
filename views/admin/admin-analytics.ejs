<!DOCTYPE html>
<html>
<head>
  <title>Pet Demand Analytics</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --bg: #f4efe6;
      --panel: #fffaf2;
      --panel-strong: #fff;
      --ink: #1f2a37;
      --muted: #6b7280;
      --accent: #0f766e;
      --accent-soft: #d1fae5;
      --warm: #c2410c;
      --warm-soft: #ffedd5;
      --line: #e5dccd;
    }

    body {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(15,118,110,0.10), transparent 28%),
        radial-gradient(circle at top right, rgba(194,65,12,0.12), transparent 30%),
        var(--bg);
    }

    .shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .actions a {
      text-decoration: none;
    }

    .actions button {
      margin-left: 10px;
    }

    button {
      border: 1px solid var(--ink);
      background: var(--panel-strong);
      color: var(--ink);
      padding: 10px 14px;
      cursor: pointer;
      font: inherit;
    }

    .hero {
      background: var(--panel);
      border: 1px solid var(--line);
      padding: 24px;
      margin-bottom: 20px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }

    .card, .panel {
      background: var(--panel-strong);
      border: 1px solid var(--line);
      padding: 18px;
    }

    .card .label {
      font-size: 13px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .card .value {
      font-size: 34px;
      margin-top: 8px;
      font-weight: 700;
    }

    .insights {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }

    .insight-teal {
      background: var(--accent-soft);
    }

    .insight-warm {
      background: var(--warm-soft);
    }

    .charts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 18px;
      margin-bottom: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--panel-strong);
      border: 1px solid var(--line);
    }

    th, td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--line);
      text-align: left;
    }

    th {
      background: var(--panel);
    }

    .muted {
      color: var(--muted);
    }

    @media (max-width: 640px) {
      .actions button {
        margin-left: 0;
        margin-top: 10px;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <div>
        <h1>Pet Demand Analytics</h1>
        <p class="muted">Aggregate demand insights across favourites, applications, and completed adoptions.</p>
      </div>
      <div class="actions">
        <a href="/home-display/admin/analytics/export">
          <button type="button">Download CSV</button>
        </a>
        <a href="/auth/admin/dashboard">
          <button type="button">Back to Dashboard</button>
        </a>
      </div>
    </div>

    <div class="hero">
      <strong>Quick read:</strong>
      <span>
        <% if (insights.topViewedBreed) { %>
          <%= insights.topViewedBreed.breed %> breed has the most views (<%= insights.topViewedBreed.views %>).
        <% } else { %>
          No view data yet.
        <% } %>
        <% if (insights.bestAdoptionBreed) { %>
          <%= insights.bestAdoptionBreed.breed %> has the highest adoption rate at <%= insights.bestAdoptionBreed.adoptionRate.toFixed(1) %>%.
        <% } else { %>
          No approved adoption data yet.
        <% } %>
      </span>
    </div>

    <div class="cards">
      <div class="card">
        <div class="label">Pets Tracked</div>
        <div class="value"><%= summary.totalPets %></div>
      </div>
      <div class="card">
        <div class="label">Total Favourites</div>
        <div class="value"><%= summary.totalFavourites %></div>
      </div>
      <div class="card">
        <div class="label">Total Views</div>
        <div class="value"><%= summary.totalViews %></div>
      </div>
      <div class="card">
        <div class="label">Adoption Applications</div>
        <div class="value"><%= summary.totalApplications %></div>
      </div>
      <div class="card">
        <div class="label">Approved Adoptions</div>
        <div class="value"><%= summary.totalApproved %></div>
      </div>
      <div class="card">
        <div class="label">Success Rate</div>
        <div class="value"><%= summary.adoptionSuccessRate.toFixed(1) %>%</div>
      </div>
    </div>

    <div class="insights">
      <div class="panel insight-teal">
        <h3>Most Favourited Breed</h3>
        <p>
          <% if (insights.topFavouritedBreed) { %>
            <strong><%= insights.topFavouritedBreed.breed %></strong> with <%= insights.topFavouritedBreed.favourites %> favourites.
          <% } else { %>
            No favourites recorded yet.
          <% } %>
        </p>
      </div>
      <div class="panel insight-warm">
        <h3>Most Viewed Breed</h3>
        <p>
          <% if (insights.topViewedBreed) { %>
            <strong><%= insights.topViewedBreed.breed %></strong> with <%= insights.topViewedBreed.views %> views.
          <% } else { %>
            No view activity recorded yet.
          <% } %>
        </p>
      </div>
      <div class="panel">
        <h3>Highest Adoption Rate</h3>
        <p>
          <% if (insights.bestAdoptionBreed) { %>
            <strong><%= insights.bestAdoptionBreed.breed %></strong> at <%= insights.bestAdoptionBreed.adoptionRate.toFixed(1) %>% (<%= insights.bestAdoptionBreed.approved %>/<%= insights.bestAdoptionBreed.applications %> approved).
          <% } else { %>
            No approved adoption outcomes yet.
          <% } %>
        </p>
      </div>
    </div>

    <div class="charts">
      <div class="panel">
        <h3>Most Favourited Breeds</h3>
        <canvas id="favouriteBreedsChart"></canvas>
      </div>
      <div class="panel">
        <h3>Most Applied Pets</h3>
        <canvas id="appliedPetsChart"></canvas>
      </div>
      <div class="panel">
        <h3>Breed Adoption Success Rate</h3>
        <canvas id="adoptionRateChart"></canvas>
      </div>
    </div>

    <div class="panel">
      <h3>Breed Breakdown</h3>
      <table>
        <thead>
          <tr>
            <th>Breed</th>
            <th>Favourites</th>
            <th>Views</th>
            <th>Applications</th>
            <th>Approved</th>
            <th>Adoption Rate</th>
          </tr>
        </thead>
        <tbody>
          <% if (breedStats.length === 0) { %>
            <tr>
              <td colspan="6">No analytics data available yet.</td>
            </tr>
          <% } %>
          <% breedStats.forEach((breed) => { %>
            <tr>
              <td><%= breed.breed %></td>
              <td><%= breed.favourites %></td>
              <td><%= breed.views %></td>
              <td><%= breed.applications %></td>
              <td><%= breed.approved %></td>
              <td><%= breed.adoptionRate.toFixed(1) %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // These arrays are prepared in adminController.showAnalyticsDashboard().
    // breedStats:
    //   grouped by breed using Pet + Favourite + PetRequest("adopt") data
    // petDemandStats:
    //   grouped by pet to show which individual pets attract the most applications
    const breedStats = <%- JSON.stringify(breedStats) %>;
    const petDemandStats = <%- JSON.stringify(petDemandStats) %>;

    // Chart 1: demand by breed based on favourite counts.
    const topFavouriteBreeds = [...breedStats]
      .sort((a, b) => b.favourites - a.favourites)
      .slice(0, 6);

    // Chart 2: demand by pet based on number of adoption applications.
    const topAppliedPets = [...petDemandStats]
      .sort((a, b) => b.applications - a.applications)
      .slice(0, 6);

    // Chart 3: conversion quality by breed based on approved/total adoption requests.
    const adoptionRateBreeds = breedStats
      .filter((breed) => breed.applications > 0)
      .sort((a, b) => b.adoptionRate - a.adoptionRate)
      .slice(0, 6);

    new Chart(document.getElementById("favouriteBreedsChart"), {
      type: "bar",
      data: {
        labels: topFavouriteBreeds.map((breed) => breed.breed),
        datasets: [{
          label: "Favourites",
          data: topFavouriteBreeds.map((breed) => breed.favourites),
          backgroundColor: "#0f766e"
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        }
      }
    });

    new Chart(document.getElementById("appliedPetsChart"), {
      type: "bar",
      data: {
        labels: topAppliedPets.map((pet) => pet.petName),
        datasets: [{
          label: "Applications",
          data: topAppliedPets.map((pet) => pet.applications),
          backgroundColor: "#c2410c"
        }]
      },
      options: {
        indexAxis: "y",
        responsive: true,
        plugins: {
          legend: { display: false }
        }
      }
    });

    new Chart(document.getElementById("adoptionRateChart"), {
      type: "line",
      data: {
        labels: adoptionRateBreeds.map((breed) => breed.breed),
        datasets: [{
          label: "Adoption Rate (%)",
          data: adoptionRateBreeds.map((breed) => Number(breed.adoptionRate.toFixed(2))),
          borderColor: "#1d4ed8",
          backgroundColor: "rgba(29, 78, 216, 0.18)",
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: {
            suggestedMin: 0,
            suggestedMax: 100
          }
        }
      }
    });
  </script>
</body>
</html>
