<html>
    <head>
        <title>Manage Adopt Requests</title>
    </head>
    <body>
        <h1>Manage Adopt Requests</h1>

        <h2>Find Adopt Request</h2>
        <form action="/find-adopt-request" method="post">
            Contact Number:
            <input type="text" name="contact">
            <button type="submit">Find</button>
        </form>

        <hr>

        <% if (existing) { %>
            <h3>Current Adopt Request</h3>
            <p>
                Housing: <strong><%= existing.housing %></strong><br>

            </p>

            <h2>Change Adopt Request</h2>
            <form action="/update-adopt-request" method="post">
                <input type="hidden" name="contact" value="<%= existing.contact %>">
                
                New Housing:
                <input type="text" name="housing" value="<%= existing.housing %>">
                <br><br>

                <button type="submit">Update Appointment</button>
            </form>

            <hr>
        <% } %>

        <h2>Delete Adopt Request</h2>
        <form action="/delete-adopt-request" method="post" onsubmit="return confirmDelete()">
            Contact Number:
            <input type="text" name="contact">
            <br><br>
            <button type="submit">Delete Adopt Request</button>
        </form>

        <script>
            function confirmDelete() {
                return confirm("Are you sure you want to delete this adopt request?");
            }
        </script>

        <br>
        <a href="/my-adopt-requests">Back to Give Up Requests List</a>


        <!-- <% if (message && message.length > 0) { %>
            <ul>
                <% message.forEach(m => { %>
                    <li><%= m %></li>
                <% }) %>
            </ul>
        <% } %>

        <% if (success) { %>
            <p><%= success %></p>
        <% } %> -->
    </body>
</html>