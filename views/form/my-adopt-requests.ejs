<html>
    <head>
        <title>List of Adopt Requests</title>
    </head>
    <body>
        <h1>List of Adopt Requests</h1>

        <% if (success) { %>
            <p><%= success %></p>
        <% } %>

        <% if (!adoptList || adoptList.length === 0) { %>
            <p>No adopt requests yet.</p>
        <% } else { %>
            <% adoptList.forEach(a => { %>
                <p>Pet Name: <%= a.petName || "-" %></p>
                <p>Contact: <%= a.contact %></p>
                <p>Housing: <%= a.housing %></p>
                <p>Status: <%= a.status %></p>

                <hr>
            <% }) %>
        <% } %>

        <br>
        <a href="/manage-adopt-request">Manage Adopt Request</a>
        <br><br>
        <a href="/home-display">Choose Another Pet</a>
    </body>
</html>
