<html>
    <head>
        <title>Rehome Dog</title>
    </head>
    <body>
        <h1>Put Up For Adoption</h1>
        <% if (error) { %>
            <p><%= error %></p>
        <% } %>
        <form action="/give-up-dog" method="post">
            <input type="hidden" name="userId" id="userId" value="" />
            Username: <input type="text" name="username" id="username" readonly required>
            <br><br>
            <!-- autofilled-->
            Owner Name: <input type="text" name="ownerName" id="ownerName" readonly required>
            <br><br>
            Contact Number: <input type="text" name="contact" id="contact" readonly required>
            <br><br>
            Address: <input type="text" name="address" id="address" readonly required>
            <br><br>
            Email: <input type="email" name="email" id="email" readonly required>
            <br><br>

            Name of Dog: <input type="text" name="petName" id="petName" value="<%= formData.petName || '' %>" required>
            <br><br>
            Breed: <input type="text" name="petBreed" id="petBreed" value="<%= formData.petBreed || '' %>" required>
            <br><br>
            Size:
            <select name="petSize" id="petSize" required>
                <option value="">-- Select Size --</option>
                <option value="S" <%= formData.petSize === "S" ? "selected" : "" %>>S</option>
                <option value="M" <%= formData.petSize === "M" ? "selected" : "" %>>M</option>
                <option value="L" <%= formData.petSize === "L" ? "selected" : "" %>>L</option>
            </select>
            <br><br>
            Age: <input type="number" min="0" name="petAge" id="petAge" value="<%= formData.petAge || '' %>" required>
            <br><br>
            HDB approved:
            <select name="petHdbApproved" id="petHdbApproved" required>
                <option value="No" <%= formData.petHdbApproved === "No" ? "selected" : "" %>>No</option>
                <option value="Yes" <%= formData.petHdbApproved === "Yes" ? "selected" : "" %>>Yes</option>
            </select>
            <br><br>
            Provide a short description of the dog: 
            <br><textarea name="details" id="details" rows="5" cols="30"><%= formData.details || '' %></textarea>
            <br><br>

            Reason for giving up your dog:
            <br><textarea name="reason" rows="5" cols="30"><%= formData.reason || '' %></textarea>
            <br><br>
            
            Photo URL:
            <input type="text" name="photo" value="<%= formData.photo || '' %>">
            <br><br>
            <button type="submit">Submit</button>
        </form>
        <br>
        <a href="/home-display">Back to Home Page</a>

        <script>
            document.addEventListener("DOMContentLoaded", async () => {
                try {
                    const response = await fetch("/user-details");
                    if (!response.ok) {
                        throw new Error("Unable to load user details");
                    }
                    const user = await response.json();

                    // Autofill user details
                    document.getElementById("userId").value = user._id;
                    document.getElementById("username").value = user.username;
                    document.getElementById("ownerName").value = user.displayName;
                    document.getElementById("contact").value = user.contact;
                    document.getElementById("address").value = user.address;
                    document.getElementById("email").value = user.email;
                } catch (error) {
                    console.error("Error fetching user details:", error);
                }
            });
        </script>
        <br><br>
        <a href="/manage-rehome-request">Change / Cancel Give Up Pet Request</a>

        <br><br>
        <a href="/my-rehome-requests">View Give Up Pet Request List</a>

    </body>
</html>
