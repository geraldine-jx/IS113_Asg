<html>
    <head>
        <title>Display Appointments</title>
    </head>
    <body>
        <h1>Display Appointments</h1>

        <% if (success) { %>
            <p><%= success %></p>
        <% } %>

        <% if (!appointmentList || appointmentList.length === 0) { %>
            <p>No appointment yet.</p>
        <% } else { %>
            <% appointmentList.forEach(a => { %>
                <p>Name: <%= a.name %></p>
                <p>Contact: <%= a.contact %></p>
                <p>Date: <%= a.date %></p>
                <p>Time: <%= a.time %></p>
                <p>Appointment Type: <%= a.appointmentType %></p>
                <hr>
            <% }) %>
        <% } %>

        <br>
        <a href="/appointment">Back to Main Page</a>
    </body>
</html>