<html>
    <head>
        <title>Make an Appointment</title>
    </head>
    <body>
        <h1>Make an Appointment</h1>

        <form action="/process-form" method="post">
            Name:
            <input type="text" name="name" value="<%= name %>">
            <br><br>

            Contact (+65):
            <input type="text" name="contact" value="<%= contact %>">
            <br><br>

            Date (DD/MM/YYYY):
            <input type="text" name="date" value="<%= date %>">
            <br><br>

            Time:
            <select name="time">
                <option value="">-- Select Time --</option>
                <% time.forEach(t => { %>
                    <option value="<%= t %>" <%= t === selectedTime ? "selected" : "" %>>
                        <%= t %>
                    </option>
                <% }) %>
            </select>
            <br><br>

            Appointment Type:
            <select name="appointmentType">
                <option value="">-- Select Type --</option>
                <option value="Adopt" <%= type === "Adopt" ? "selected" : "" %>>Adopt</option>
                <option value="Give Up" <%= type === "Give Up" ? "selected" : "" %>>Give Up</option>
            </select>
            <br><br>

            <button type="submit">Confirm Appointment</button>
        </form>

        <br>
        <a href="/manageappointment">Change / Cancel Appointment</a>
        <br><br>
        <a href="/myappointment">View Appointment</a>

        <% if (message && message.length > 0) { %>
            <ul>
                <% message.forEach(m => { %>
                    <li><%= m %></li>
                <% }) %>
            </ul>
        <% } %>

        <% if (success) { %>
            <p><%= success %></p>
        <% } %>
    </body>
</html>