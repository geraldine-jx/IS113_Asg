<!DOCTYPE html>
<html>
<head>
  <title>User Sign-in/Sign-up</title>
</head>
<body>
  <h1>User Sign-in/Signup</h1>

  <% if (error) { %>
    <p><%= error %></p>
  <% } %>

<form action="/auth/userlogin-process" method="POST">    
    Username:<br>
    <input type="text" name="username">
    <br><br>

    Password:<br>
    <input type="password" name="password">
    <br><br>

    <button type="submit">Sign-in</button>
  </form>

  <br>

  <a href="/auth/user/forgot-password">
    <button type="button">Forgot Password</button>
  </a>

  <br><br>

  <a href="/auth/register?usertype=user">
    <button type="button">No Account? Register</button>
  </a>

  <a href="/mainpage">
    <button type="button">Back</button>
  </a>
  
</body>
</html>
