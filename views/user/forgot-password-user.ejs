<!DOCTYPE html>
<html>
<head>
  <title>User Forgot Password</title>
</head>
<body>
  <h1>User Forgot Password</h1>

  <% if (error) { %>
    <div><%- error %></div>
  <% } %>

  <% if (message) { %>
    <p><%= message %></p>
  <% } %>

  <form action="/auth/user/forgot-password" method="post">
    Username:<br>
    <input type="text" name="username">
    <br><br>

    Email:<br>
    <input type="email" name="email">
    <br><br>

    New Password:<br>
    <input type="password" name="newPassword">
    <br><br>

    Confirm New Password:<br>
    <input type="password" name="confirmPassword">
    <br><br>

    <button type="submit">Reset Password</button>
  </form>

  <br>

  <a href="/auth/login?usertype=user">
    <button type="button">Back to User Login</button>
  </a>
</body>
</html>
