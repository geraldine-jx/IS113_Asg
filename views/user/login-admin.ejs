<!DOCTYPE html>
<html>
<head>
  <title>Admin Login</title>
</head>
<body>
  <h1>Admin Login</h1>

  <% if (error) { %>
    <div><%= error %></div>
  <% } %>

  <form action="/auth/adminlogin-process" method="POST">
    Employee ID:<br>
    <input type="text" name="employeeID" required>
    <br><br>

    Username:<br>
    <input type="text" name="username" required>
    <br><br>

    Password:<br>
    <input type="password" name="password" required>
    <br><br>

    <button type="submit">Login</button>
  </form>
</body>
</html>