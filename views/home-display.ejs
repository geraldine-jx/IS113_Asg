<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Home</title>
</head>
<body>
    <h1>Get your Best Buddy Now!</h1>

    <table border ="1"> 
        <% pets.forEach(pet => { %>
        <tr>
            <td>
                <!-- Display image -->
            </td>
            <td>
                <!-- Display information -->
                Name: <%= pet.name %> <br>
                Breed: <%= pet.breed %> <br>
                Age: <%= pet.age %> <br>
                Status: <%= pet.status %><br>
                <br>
                <button type="adopt">Adopt</button> 
                <button type="details">More Info</button>
            </td>
        </tr>
        <% }) %>
    </table>
    
</body>
</html>